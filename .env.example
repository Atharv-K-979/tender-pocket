# ==============================================================================
# TenderPocket Environment Variables Template
# Copy this file to .env in the repository root and replace every placeholder.
# docker-compose.yml reads all passwords, secrets, keys and service URLs from .env;
# it stops with an error if JWT_SECRET, DATABASE_PASSWORD or BACKEND_URL is missing.
# NEVER commit .env or any real credential to source control.
# Generate secrets with: openssl rand -hex 64
# ==============================================================================

# Server Ports
SPRING_PORT=8090
PORT=8085

# Service URLs
# BACKEND_URL (required): inside Docker the frontend reaches the backend by its service name.
# Use http://localhost:8090 when running the frontend outside Docker.
BACKEND_URL=http://tender-pocket-backend:8090
NEXT_PUBLIC_APP_URL=http://localhost:8085
TENDER_API_URL=http://localhost:8085/api/process-email
# Comma-separated browser origins allowed by the backend (CORS). Leave empty for the default.
ALLOWED_ORIGINS=

# PostgreSQL (DATABASE_PASSWORD is required)
POSTGRES_DB=tender_pocket
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here
# Inside Docker the backend reaches PostgreSQL by its service name "postgres".
# Use localhost instead of postgres when running the backend outside Docker.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tender_pocket?sslmode=disable
# Used only when the backend runs outside Docker (Docker takes them from DATABASE_USERNAME / DATABASE_PASSWORD)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
DATABASE_URL=jdbc:postgresql://localhost:5432/tender_pocket?sslmode=disable
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Frontend SQLite Database Path (Optional - defaults to ./tenders.db)
DATABASE_PATH=./tenders.db

# Security & JWT Token (required). One long random secret shared by the backend and the frontend.
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRATION=315360000

# Login passwords for the default accounts, used when each account is first created.
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password
EXECUTIVE_DEFAULT_PASSWORD=your_initial_executive_password
CLEARANCE_DEFAULT_PASSWORD=your_initial_clearance_password
TPC_DEFAULT_PASSWORD=your_initial_tpc_password
MISTEAM_DEFAULT_PASSWORD=your_initial_mis_password
SPECTEAM_DEFAULT_PASSWORD=your_initial_spec_password
# Brochure Team login (username: brochure). The account is created on the first login attempt
# once this is set; changing it later does not change an existing account's password.
BROCHURE_DEFAULT_PASSWORD=your_initial_brochure_password

# Document Storage (S3 is used only when AWS_S3_ENABLED=true)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_S3_ENABLED=false
FILE_UPLOAD_DIR=public/documents
FILE_TEMPLATE_DIR=public/templates

# Email Alerts (Spring Boot SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
SPRING_MAIL_SMTP_AUTH=true

# Email Alerts (Frontend / Node.js SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MANAGER_EMAIL=manager@company.com

# IMAP Email Scraping (Auto-sync tenders from emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_USER=your_email@gmail.com
IMAP_SENDER_FILTER=sales@tender247.com
SUBJECT_FILTER=Tender247

# AI Keys (technical specification parsing)
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Technical specification cost reporting (USD per million tokens; INR rate optional)
TECHSPEC_GPT_INPUT_USD_PER_MILLION=0.05
TECHSPEC_GPT_CACHED_INPUT_USD_PER_MILLION=0.005
TECHSPEC_GPT_OUTPUT_USD_PER_MILLION=0.40
TECHSPEC_USD_TO_INR_RATE=
TECHSPEC_USD_TO_INR_RATE_DATE=
