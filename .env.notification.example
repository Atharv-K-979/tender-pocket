# ==============================================================================
# TenderPocket daily mails: settings
#
# Copy this file to .env.notification (same folder) and fill it in. That file is
# git-ignored, so the app password never reaches GitHub.
#
#   Docker:  docker-compose.yml passes it to the backend (env_file). Rebuild or
#            restart the backend after editing:
#              docker compose up -d --build tender-pocket-backend
#   Local:   the backend also reads it directly when started from backend/ or the
#            repo root (spring.config.import in application.properties).
#
# Write values without quotes. Lines starting with # are ignored.
# ==============================================================================

# Master switch. Nothing is sent while this is false (preview still works).
NOTIFY_ENABLED=false

# ---- Sender (the account the mails come from) --------------------------------
# Gmail: use a 16-letter App Password (Google Account > Security > App passwords),
# not the normal password. Spaces in it are ignored.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
# Optional sender address. Leave empty to send as NOTIFY_SMTP_USERNAME (Gmail only
# allows that address or an alias added in Gmail settings).
NOTIFY_MAIL_FROM=
# The name people see as the sender, e.g. TenderPocket Alerts.
NOTIFY_MAIL_FROM_NAME=TenderPocket Alerts
# auto = SSL on 465, STARTTLS on 587. Or set ssl / starttls / none.
NOTIFY_SMTP_SECURITY=auto

# ---- Receivers ----------------------------------------------------------------
# Each login gets mail at its users.email address. A line below replaces that
# address for one login: NOTIFY_RECIPIENT_<USERNAME in capitals>.
NOTIFY_RECIPIENT_ADMIN=
NOTIFY_RECIPIENT_MISTEAM=
NOTIFY_RECIPIENT_EXECUTIVE=
NOTIFY_RECIPIENT_CLEARANCE=
NOTIFY_RECIPIENT_TPC=

# Test mode: when set, EVERY login's mail goes to this one inbox instead, with
# "[for <login>]" in the subject. Leave empty in production.
NOTIFY_REDIRECT_ALL_TO=

# ---- Schedule and rules (defaults shown) -------------------------------------
# Spring cron, seconds first, Asia/Kolkata time. Default: every day at 9:00.
NOTIFY_CRON=0 0 9 * * *
# A step shows in the Pending mail after waiting more than this many days.
NOTIFY_PENDING_DAYS=3
# The Due mail lists tenders due today and up to this many days ahead.
NOTIFY_DUE_WINDOW_DAYS=3
# Most rows shown in a mail body. If a mail has more rows (or they would make the
# mail too big for Gmail), the body shows the most urgent ones and an Excel file
# with every row is attached to the same mail. Nothing is ever left out.
NOTIFY_MAX_ROWS=200
# Address of the live web app. Each tender title in the mails links to
# <url>/tenders/<id>, so people open that tender directly. Anything after "#"
# (such as /#/dashboard) is ignored.
NOTIFY_APP_URL=http://13.232.232.54:8085
